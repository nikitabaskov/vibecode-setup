{
  "attribution": false,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ruff-format.sh pre",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ruff-format.sh post",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "api-and-interface-design": "off",
    "ci-cd-and-automation": "off",
    "context-engineering": "off",
    "deprecation-and-migration": "off",
    "find-skills": "off",
    "frontend-ui-engineering": "off",
    "git-workflow-and-versioning": "off",
    "idea-refine": "off",
    "interview-me": "off",
    "lean-build": "off",
    "observability-and-instrumentation": "off",
    "safe-refactor": "off",
    "source-driven-development": "off",
    "surgical-patch": "off",
    "using-agent-skills": "off",
    "verify-and-stop": "off",
    "cavecrew": "off",
    "caveman": "off",
    "caveman-commit": "off",
    "caveman-compress": "off",
    "caveman-discover": "off",
    "caveman-evidence-review": "off",
    "caveman-explore": "off",
    "caveman-help": "off",
    "caveman-learn": "off",
    "caveman-manage": "off",
    "caveman-optimize": "off",
    "caveman-review": "off",
    "caveman-setup": "off",
    "caveman-stats": "off",
    "megacave": "off",
    "ultracave": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "loop": "off",
    "schedule": "off",
    "claude-api": "off",
    "run": "off",
    "plugin-authoring": "off",
    "init": "off",
    "build": "user-invocable-only",
    "spec": "user-invocable-only",
    "plan": "user-invocable-only",
    "test": "user-invocable-only",
    "review": "user-invocable-only",
    "ship": "user-invocable-only",
    "constraints": "user-invocable-only",
    "code-simplify": "user-invocable-only",
    "code-review": "user-invocable-only",
    "security-review": "user-invocable-only",
    "browser-testing-with-devtools": "off",
    "computer-use": "off",
    "built-in-browser": "off",
    "chrome-browser": "off",
    "morning": "off",
    "google-workspace": "off",
    "import-memory": "off",
    "docs": "off",
    "dataviz": "name-only"
  }
}
